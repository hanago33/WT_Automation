@echo off
chcp 65001 >nul
setlocal
cd /d "%~dp0"

rem ============================================================
rem  WT 服务器 一键会话修复
rem  合并原 5 步为 1 次运行：
rem   1) 部署发布包（可选：拖入 zip 路径作为第 1 参数）
rem   2) 会话诊断（SessionId 一致性 + UIPI 权限一致性）
rem   3) 杀净旧服务 + 当前会话重启（--server --force 幂等）
rem   4) GM_EXE 配置修复（.lnk -> .exe）
rem   5) 提示下一步（提交远程任务验证 size=1920x1040）
rem  用法:  服务器一键会话修复.bat           只修复服务
rem         服务器一键会话修复.bat 发布包.zip 先部署再修复
rem ============================================================

set "PY=D:\wt_python\python.exe"
if not exist "%PY%" set "PY=%~dp0..\wt_python\python.exe"
if not exist "%PY%" set "PY=%~dp0wt_python\python.exe"
if not exist "%PY%" (
  echo [ERROR] 未找到便携 python。请编辑本 bat 顶部 PY 变量。
  pause
  exit /b 1
)

echo ============================================================
echo   1/5 部署发布包（可选步骤）
echo ============================================================
if not "%~1"=="" (
  if exist "%~1" (
    echo   部署: %~1
    "%PY%" "%~dp0deploy_release.py" "%~1" "%~dp0" --latest
  ) else (
    echo   [跳过] 找不到 zip: %~1
  )
) else (
  echo   [跳过] 未提供 zip 路径（如需部署请把 发布包_*.zip 拖到本 bat 上）
)

echo.
echo ============================================================
echo   2/5 会话诊断（SessionId + UIPI 权限一致性）
echo ============================================================
"%PY%" "%~dp0diagnose_session.py"

echo.
echo ============================================================
echo   3/5 杀净旧服务并在当前会话重启（--server --force）
echo ============================================================
"%PY%" "%~dp0wt_queue_selfcheck.py" --server --force

echo.
echo ============================================================
echo   4/5 GM_EXE 配置修复（.lnk -^> .exe）
echo ============================================================
"%PY%" "%~dp0fix_server_gm_exe.py"

echo.
echo ============================================================
echo   5/5 下一步指引
echo ============================================================
echo   ① 确认上方诊断无 [MISMATCH] / [UIPI 风险]
echo   ② 提交远程任务，健康检查应看到 size=1920x1040（而非 160x28）
echo   ③ 若步骤仍报「未命中控件」，重跑本脚本再看诊断结论
echo ============================================================
echo.
pause
