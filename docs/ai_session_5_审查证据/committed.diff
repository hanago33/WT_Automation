+        "DEBUG": "#94a3b8",
+        "INFO": "#0f172a",
+        "WARN": "#b45309",
+        "ERROR": "#dc2626",
+        "CRIT": "#991b1b",
+        "debug": "#94a3b8",
+        "info": "#0f172a",
